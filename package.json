{
  "name": "globus-fitness",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names client,server \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "lint": "npm run lint --workspaces",
    "start": "npm run start --workspace server",
    "prisma:validate": "npm run prisma:validate --workspace server",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:format": "npm run prisma:format --workspace server",
    "db:setup": "npm run prisma:generate && npm run db:migrate --workspace server && npm run prisma:seed --workspace server",
    "test": "npm run test --workspace server",
    "test:integration": "npm run test:integration --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

