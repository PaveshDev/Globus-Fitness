NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Server only. Runtime uses pooled Neon URL; DIRECT_URL is optional for migrations.
DATABASE_URL=
DIRECT_URL=
# Example format only:
# postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a random secret of at least 32 characters. Sessions expire after one day.
JWT_SECRET=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# Public HTTPS origin of Express, without /api; required for gateway callbacks.
PUBLIC_API_URL=

# Server-only credentials for uploading original image files to Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

